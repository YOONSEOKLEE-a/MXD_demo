            ],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 300,
            "values": [
              "#\n#  Copyright (c) 2023 Contributors to the Eclipse Foundation\n#\n#  See the NOTICE file(s) distributed with this work for additional\n#  information regarding copyright ownership.\n#\n#  This program and the accompanying materials are made available under the\n#  terms of the Apache License, Version 2.0 which is available at\n#  https://www.apache.org/licenses/LICENSE-2.0\n#\n#  Unless required by applicable law or agreed to in writing, software\n#  distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n#  WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the\n#  License for the specific language governing permissions and limitations\n#  under the License.\n#\n#  SPDX-License-Identifier: Apache-2.0\n#\n---\n\n################################\n# EDC ControlPlane + DataPlane #\n################################\nparticipant:\n  id: \"test-participant\"\ncontrolplane:\n  debug:\n    enabled: true\n    port: 1044\n  livenessProbe:\n    enabled: true\n    initialDelaySeconds: 5\n    periodSeconds: 5\n  readinessProbe:\n    enabled: true\n    initialDelaySeconds: 5\n    periodSeconds: 5\n  service:\n    type: NodePort\n  endpoints:\n    management:\n      authKey: password\n# uncomment the following lines if a custom tx-control-plane runtime images should be used.\n  image:\n    pullPolicy: Always\n\n  securityContext:\n    # avoids some errors in the log: cannot write temp files of large multipart requests when R/O\n    readOnlyRootFilesystem: false\ndataplane:\n  debug:\n    enabled: true\n    port: 1044\n  livenessProbe:\n    enabled: true\n    initialDelaySeconds: 5\n    periodSeconds: 5\n  readinessProbe:\n    enabled: true\n    initialDelaySeconds: 5\n    periodSeconds: 5\n  image:\n    pullPolicy: Always\n#    repository: \"edc-dataplane-hashicorp-vault\"\n  securityContext:\n    # avoids some errors in the log: cannot write temp files of large multipart requests when R/O\n    readOnlyRootFilesystem: false\n  aws:\n    endpointOverride: http://minio:9000\n    secretAccessKey: qwerty123\n    accessKeyId: qwerty123\n\n  env:\n    \"EDC_API_AUTH_KEY\" : \"password\"\n\npostgresql:\n   # JDBC URL should be set from `main.tf`\n   jdbcUrl:\n#  jdbcUrl: jdbc:postgresql://{{ .Release.Name }}-postgresql:5432/edc\n   auth:\n     username:\n     password:\nvault:\n  hashicorp:\n    url: http://{{ .Release.Name }}-vault:8200\n    token: root\n    secrets:\nbackendService:\n  httpProxyTokenReceiverUrl: \"http://backend:8080\"\ntests:\n  hookDeletePolicy: before-hook-creation",
              "\"vault\":\n  \"server\":\n    \"postStart\":\n    - \"sh\"\n    - \"-c\"\n    - \"sleep 5 \u0026\u0026 /bin/vault kv put secret/edc.aws.access.key content=bobawsclient\n      \u0026\u0026 /bin/vault kv put secret/edc.aws.secret.access.key content=bobawssecret \u0026\u0026\n      /bin/vault kv put secret/bobazureaccount-key content=Ym9iYXp1cmVrZXk= \u0026\u0026 /bin/vault\n      kv put secret/bobazureaccount-sas content='{\\\"edctype\\\":\\\"dataspaceconnector:azuretoken\\\",\\\"sas\\\":\\\"sv=2023-01-03\\\\u0026ss=btqf\\\\u0026srt=sco\\\\u0026st=2023-11-23T13%3A18%3A49Z\\\\u0026se=2030-01-01T00%3A00%3A00Z\\\\u0026sp=rwdftlacup\\\\u0026sig=Xki%2B2nHBT2V8oe%2BMmS%2BI%2FHzcAsTFCYWDv6t6zT%2FWXFM%3D\\\"}'\"\n",
              "\"controlplane\":\n  \"volumeMounts\":\n  - \"mountPath\": \"/app/participants.json\"\n    \"name\": \"participants\"\n    \"subPath\": \"participants.json\"\n  \"volumes\":\n  - \"configMap\":\n      \"items\":\n      - \"key\": \"participants.json\"\n        \"path\": \"participants.json\"\n      \"name\": \"bob-participants\"\n    \"name\": \"participants\"\n",
              "\"controlplane\":\n  \"bdrs\":\n    \"server\":\n      \"url\": \"http://bdrs-server:8082/api/directory\"\n  \"catalog\":\n    \"crawler\":\n      \"initialDelay\": 10\n      \"period\": 10\n      \"targetsFile\": \"/app/participants.json\"\n    \"enabled\": true\n  \"env\":\n    \"EDC_BLOBSTORE_ENDPOINT_TEMPLATE\": \"http://azurite:10000/%s\"\n    \"EDC_COMPONENT_ID\": \"bob\"\n    \"EDC_DATAPLANE_SELECTOR_DEFAULTPLANE_DESTINATIONTYPES\": \"HttpProxy,AmazonS3,AzureStorage\"\n    \"EDC_DATAPLANE_SELECTOR_DEFAULTPLANE_SOURCETYPES\": \"HttpData,AmazonS3,AzureStorage\"\n    \"EDC_DSP_CALLBACK_ADDRESS\": \"http://bob-controlplane:8084/api/v1/dsp\"\n    \"EDC_HOSTNAME\": \"bob-tractusx-connector-controlplane\"\n    \"EDC_IAM_DID_WEB_USE_HTTPS\": \"false\"\n    \"EDC_IAM_TRUSTED-ISSUER_DATASPACE-ISSUER_ID\": \"did:web:dataspace-issuer\"\n    \"EDC_IAM_TRUSTED-ISSUER_DATASPACE-ISSUER_SUPPORTEDTYPES\": \"[\\\"*\\\"]\"\n    \"TX_SSI_ENDPOINT_AUDIENCE\": \"http://bob-controlplane:8084/api/v1/dsp\"\n\"dataplane\":\n  \"aws\":\n    \"endpointOverride\": \"http://bob-minio:9000\"\n  \"env\":\n    \"EDC_BLOBSTORE_ENDPOINT_TEMPLATE\": \"http://azurite:10000/%s\"\n    \"EDC_IAM_DID_WEB_USE_HTTPS\": false\n  \"token\":\n    \"signer\":\n      \"privatekey_alias\": \"did:web:bob-ih%3A7083:bob#signing-key-1\"\n    \"verifier\":\n      \"publickey_alias\": \"did:web:bob-ih%3A7083:bob#signing-key-1\"\n\"iatp\":\n  \"id\": \"did:web:bob-ih%3A7083:bob\"\n  \"sts\":\n    \"oauth\":\n      \"client\":\n        \"id\": \"did:web:bob-ih%3A7083:bob\"\n        \"secret_alias\": \"did:web:bob-ih%3A7083:bob-sts-client-secret\"\n      \"token_url\": \"http://bob-ih:7084/api/sts/token\"\n"
