            "disable_webhooks": false,
            "force_update": true,
            "id": "bob",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "0.9.0",
                "chart": "tractusx-connector",
                "name": "bob",
                "namespace": "mxd",
                "revision": 1,
                "values": "{\"backendService\":{\"httpProxyTokenReceiverUrl\":\"http://backend:8080\"},\"controlplane\":{\"bdrs\":{\"server\":{\"url\":\"http://bdrs-server:8082/api/directory\"}},\"catalog\":{\"crawler\":{\"initialDelay\":10,\"period\":10,\"targetsFile\":\"/app/participants.json\"},\"enabled\":true},\"debug\":{\"enabled\":true,\"port\":1044},\"endpoints\":{\"management\":{\"authKey\":\"password\"}},\"env\":{\"EDC_BLOBSTORE_ENDPOINT_TEMPLATE\":\"http://azurite:10000/%s\",\"EDC_COMPONENT_ID\":\"bob\",\"EDC_DATAPLANE_SELECTOR_DEFAULTPLANE_DESTINATIONTYPES\":\"HttpProxy,AmazonS3,AzureStorage\",\"EDC_DATAPLANE_SELECTOR_DEFAULTPLANE_SOURCETYPES\":\"HttpData,AmazonS3,AzureStorage\",\"EDC_DSP_CALLBACK_ADDRESS\":\"http://bob-controlplane:8084/api/v1/dsp\",\"EDC_HOSTNAME\":\"bob-tractusx-connector-controlplane\",\"EDC_IAM_DID_WEB_USE_HTTPS\":\"false\",\"EDC_IAM_TRUSTED-ISSUER_DATASPACE-ISSUER_ID\":\"did:web:dataspace-issuer\",\"EDC_IAM_TRUSTED-ISSUER_DATASPACE-ISSUER_SUPPORTEDTYPES\":\"[\\\"*\\\"]\",\"TX_SSI_ENDPOINT_AUDIENCE\":\"http://bob-controlplane:8084/api/v1/dsp\"},\"image\":{\"pullPolicy\":\"Always\"},\"livenessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"readinessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"securityContext\":{\"readOnlyRootFilesystem\":false},\"service\":{\"type\":\"NodePort\"},\"volumeMounts\":[{\"mountPath\":\"/app/participants.json\",\"name\":\"participants\",\"subPath\":\"participants.json\"}],\"volumes\":[{\"configMap\":{\"items\":[{\"key\":\"participants.json\",\"path\":\"participants.json\"}],\"name\":\"bob-participants\"},\"name\":\"participants\"}]},\"dataplane\":{\"aws\":{\"accessKeyId\":\"qwerty123\",\"endpointOverride\":\"http://bob-minio:9000\",\"secretAccessKey\":\"qwerty123\"},\"debug\":{\"enabled\":true,\"port\":1044},\"env\":{\"EDC_API_AUTH_KEY\":\"password\",\"EDC_BLOBSTORE_ENDPOINT_TEMPLATE\":\"http://azurite:10000/%s\",\"EDC_IAM_DID_WEB_USE_HTTPS\":false},\"image\":{\"pullPolicy\":\"Always\"},\"livenessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"readinessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"securityContext\":{\"readOnlyRootFilesystem\":false},\"token\":{\"signer\":{\"privatekey_alias\":\"did:web:bob-ih%3A7083:bob#signing-key-1\"},\"verifier\":{\"publickey_alias\":\"did:web:bob-ih%3A7083:bob#signing-key-1\"}}},\"iatp\":{\"id\":\"did:web:bob-ih%3A7083:bob\",\"sts\":{\"oauth\":{\"client\":{\"id\":\"did:web:bob-ih%3A7083:bob\",\"secret_alias\":\"did:web:bob-ih%3A7083:bob-sts-client-secret\"},\"token_url\":\"http://bob-ih:7084/api/sts/token\"}}},\"install\":{\"postgresql\":false},\"participant\":{\"id\":\"BPNL000000000002\"},\"postgresql\":{\"auth\":{\"password\":\"bob\",\"username\":\"bob\"},\"jdbcUrl\":\"jdbc:postgresql://10.96.2.201:5432/bob\"},\"tests\":{\"hookDeletePolicy\":\"before-hook-creation\"},\"vault\":{\"hashicorp\":{\"secrets\":null,\"token\":\"root\",\"url\":\"http://{{ .Release.Name }}-vault:8200\"},\"server\":{\"postStart\":[\"sh\",\"-c\",\"sleep 5 \\u0026\\u0026 /bin/vault kv put secret/edc.aws.access.key content=bobawsclient \\u0026\\u0026 /bin/vault kv put secret/edc.aws.secret.access.key content=bobawssecret \\u0026\\u0026 /bin/vault kv put secret/bobazureaccount-key content=Ym9iYXp1cmVrZXk= \\u0026\\u0026 /bin/vault kv put secret/bobazureaccount-sas content='{\\\"edctype\\\":\\\"dataspaceconnector:azuretoken\\\",\\\"sas\\\":\\\"sv=2023-01-03\\\\u0026ss=btqf\\\\u0026srt=sco\\\\u0026st=2023-11-23T13%3A18%3A49Z\\\\u0026se=2030-01-01T00%3A00%3A00Z\\\\u0026sp=rwdftlacup\\\\u0026sig=Xki%2B2nHBT2V8oe%2BMmS%2BI%2FHzcAsTFCYWDv6t6zT%2FWXFM%3D\\\"}'\"]}}}",
                "version": "0.9.0"
              }
            ],
            "name": "bob",
            "namespace": "mxd",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": true,
            "repository": "https://eclipse-tractusx.github.io/charts/dev",
