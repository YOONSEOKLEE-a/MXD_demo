            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "0.9.0",
                "chart": "tractusx-connector",
                "name": "alice",
                "namespace": "mxd",
                "revision": 1,
                "values": "{\"backendService\":{\"httpProxyTokenReceiverUrl\":\"http://backend:8080\"},\"controlplane\":{\"bdrs\":{\"server\":{\"url\":\"http://bdrs-server:8082/api/directory\"}},\"catalog\":{\"crawler\":{\"initialDelay\":10,\"period\":10,\"targetsFile\":\"/app/participants.json\"},\"enabled\":true},\"debug\":{\"enabled\":true,\"port\":1044},\"endpoints\":{\"management\":{\"authKey\":\"password\"}},\"env\":{\"EDC_BLOBSTORE_ENDPOINT_TEMPLATE\":\"http://azurite:10000/%s\",\"EDC_COMPONENT_ID\":\"alice\",\"EDC_DATAPLANE_SELECTOR_DEFAULTPLANE_DESTINATIONTYPES\":\"HttpProxy,AmazonS3,AzureStorage\",\"EDC_DATAPLANE_SELECTOR_DEFAULTPLANE_SOURCETYPES\":\"HttpData,AmazonS3,AzureStorage\",\"EDC_DSP_CALLBACK_ADDRESS\":\"http://alice-controlplane:8084/api/v1/dsp\",\"EDC_HOSTNAME\":\"alice-tractusx-connector-controlplane\",\"EDC_IAM_DID_WEB_USE_HTTPS\":\"false\",\"EDC_IAM_TRUSTED-ISSUER_DATASPACE-ISSUER_ID\":\"did:web:dataspace-issuer\",\"EDC_IAM_TRUSTED-ISSUER_DATASPACE-ISSUER_SUPPORTEDTYPES\":\"[\\\"*\\\"]\",\"TX_SSI_ENDPOINT_AUDIENCE\":\"http://alice-controlplane:8084/api/v1/dsp\"},\"image\":{\"pullPolicy\":\"Always\"},\"livenessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"readinessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"securityContext\":{\"readOnlyRootFilesystem\":false},\"service\":{\"type\":\"NodePort\"},\"volumeMounts\":[{\"mountPath\":\"/app/participants.json\",\"name\":\"participants\",\"subPath\":\"participants.json\"}],\"volumes\":[{\"configMap\":{\"items\":[{\"key\":\"participants.json\",\"path\":\"participants.json\"}],\"name\":\"alice-participants\"},\"name\":\"participants\"}]},\"dataplane\":{\"aws\":{\"accessKeyId\":\"qwerty123\",\"endpointOverride\":\"http://alice-minio:9000\",\"secretAccessKey\":\"qwerty123\"},\"debug\":{\"enabled\":true,\"port\":1044},\"env\":{\"EDC_API_AUTH_KEY\":\"password\",\"EDC_BLOBSTORE_ENDPOINT_TEMPLATE\":\"http://azurite:10000/%s\",\"EDC_IAM_DID_WEB_USE_HTTPS\":false},\"image\":{\"pullPolicy\":\"Always\"},\"livenessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"readinessProbe\":{\"enabled\":true,\"initialDelaySeconds\":5,\"periodSeconds\":5},\"securityContext\":{\"readOnlyRootFilesystem\":false},\"token\":{\"signer\":{\"privatekey_alias\":\"did:web:alice-ih%3A7083:alice#signing-key-1\"},\"verifier\":{\"publickey_alias\":\"did:web:alice-ih%3A7083:alice#signing-key-1\"}}},\"iatp\":{\"id\":\"did:web:alice-ih%3A7083:alice\",\"sts\":{\"oauth\":{\"client\":{\"id\":\"did:web:alice-ih%3A7083:alice\",\"secret_alias\":\"did:web:alice-ih%3A7083:alice-sts-client-secret\"},\"token_url\":\"http://alice-ih:7084/api/sts/token\"}}},\"install\":{\"postgresql\":false},\"participant\":{\"id\":\"BPNL000000000001\"},\"postgresql\":{\"auth\":{\"password\":\"alice\",\"username\":\"alice\"},\"jdbcUrl\":\"jdbc:postgresql://10.96.36.156:5432/alice\"},\"tests\":{\"hookDeletePolicy\":\"before-hook-creation\"},\"vault\":{\"hashicorp\":{\"secrets\":null,\"token\":\"root\",\"url\":\"http://{{ .Release.Name }}-vault:8200\"},\"server\":{\"postStart\":[\"sh\",\"-c\",\"sleep 5 \\u0026\\u0026 /bin/vault kv put secret/edc.aws.access.key content=aliceawsclient \\u0026\\u0026 /bin/vault kv put secret/edc.aws.secret.access.key content=aliceawssecret \\u0026\\u0026 /bin/vault kv put secret/aliceazureaccount-key content=YWxpY2VhenVyZWtleQ== \\u0026\\u0026 /bin/vault kv put secret/aliceazureaccount-sas content='{\\\"edctype\\\":\\\"dataspaceconnector:azuretoken\\\",\\\"sas\\\":\\\"sv=2023-01-03\\\\u0026ss=btqf\\\\u0026srt=sco\\\\u0026st=2023-11-23T13%3A17%3A09Z\\\\u0026se=2030-01-01T00%3A00%3A00Z\\\\u0026sp=rwdxftlacup\\\\u0026sig=uvPcqmLj7%2FMuadAKXMCA7SvWCnClQ9EA1b15OB0m1bc%3D\\\"}'\"]}}}",
